# 数据库
DATABASE_URL=
# JWT 签名密钥，生产环境请使用足够长的随机值
SECRET_KEY=
# 投保个人信息 Fernet 加密密钥，可用 `Fernet.generate_key()` 生成
PII_ENCRYPTION_KEY=
# 允许访问 API 的前端 Origin，多个值使用英文逗号分隔
CORS_ALLOWED_ORIGINS=https://ai.lihaichao.cn
# 统一 LLM 配置；LLM_MODELS 的顺序也是故障切换顺序
LLM_PROVIDER=deepseek
LLM_API_KEY=
# 留空时使用提供商 SDK 的默认地址
LLM_BASE_URL=
LLM_MODELS=deepseek-flash,deepseek-v4-pro
LLM_DEFAULT_MODEL=deepseek-flash
LLM_FAST_MODEL=deepseek-flash
LLM_TEXT2SQL_MODEL=deepseek-flash
LLM_DEFAULT_TEMPERATURE=0.7
# 旧客户端和历史 checkpoint 的兼容别名，确认迁移完成后可改成 {}
LLM_MODEL_ALIASES={"deepseek-v4-flash":"deepseek-flash"}
# 联网搜索
TAVILY_API_KEY=
# 向量配置
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL_NAME=BAAI/bge-m3
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
# Langfuse 观测平台
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
